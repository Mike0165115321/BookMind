# Gemini API Keys (รองรับการใส่หลายคีย์คั่นด้วยคอมม่า เพื่อทำ Round-robin)
GEMINI_API_KEYS="your_gemini_api_key_1,your_gemini_api_key_2"

# Groq API Keys (สำหรับ HyDE และ Agentic)
GROQ_API_KEYS="your_groq_api_key_1,your_groq_api_key_2"

OPENROUTER_API_KEYS="your_openrouter_api_key_1,your_openrouter_api_key_2"

# Optional: Overrides (ถ้าไม่ใส่จะใช้ค่า Default ในโค้ด)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.3
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TEMPERATURE=0.7

# Optional: OpenRouter Overrides
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_TEMPERATURE=0.3
# OPENROUTER_MAX_TOKENS=4096
